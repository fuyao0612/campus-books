DB_DSN=sqlserver://数据库用户名:数据库密码@localhost:1433?database=数据库名称&encrypt=disable
JWT_SECRET=替换为至少32字节的随机签名密钥
SEED_USER_NAME=你的姓名
SEED_USER_PASSWORD=你的学号

# 仅用于沙箱。填写真实本机配置到 .env，不在此示例提交密钥。
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=替换为沙箱APPID
ALIPAY_SELLER_ID=替换为沙箱商家支付宝用户ID
ALIPAY_APP_PRIVATE_KEY_FILE=secrets/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_FILE=secrets/alipay-public.pem
ALIPAY_RETURN_BASE_URL=http://127.0.0.1:5174/payment.html
# 准备阶段可留空；实际支付前必须填写公网 HTTPS 通知地址。
ALIPAY_NOTIFY_URL=
